  <library_effects>
    <effect id="Curtains-effect">
      <profile_COMMON>
        <newparam sid="Curtains_jpg-surface">
          <surface type="2D">
            <init_from>Curtains_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="Curtains_jpg-sampler">
          <sampler2D>
            <source>Curtains_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Curtains_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
